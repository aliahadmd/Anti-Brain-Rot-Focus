{
  "manifest_version": 3,
  "name": "Anti-Brain Rot Focus",
  "version": "1.3.0",
  "description": "Block distracting domains, earn focus medals, and review local analytics.",
  "permissions": [
    "storage",
    "webNavigation",
    "tabs",
    "alarms"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "Focus Settings"
  },
  "options_page": "options.html",
  "web_accessible_resources": [
    {
      "resources": ["blocked.html", "blocked.css"],
      "matches": ["<all_urls>"]
    }
  ],
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
