{
  "manifest_version": 3,
  "name": "Anti-Brain Rot Focus",
  "version": "2.2.0",
  "description": "Block distracting domains, earn focus medals, and review local analytics.",
  "minimum_chrome_version": "116",
  "permissions": [
    "storage",
    "webNavigation",
    "alarms",
    "declarativeNetRequest"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "Focus Settings"
  },
  "options_page": "options.html",
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
